// SPDX-License-Identifier: GPL-2.0-or-later
// Device Tree Source for Ruijie IPQ6018-based router
// Generated from live DTB dump
// Board: qcom,ipq6018-cp01-c1 variant
// SoC:   Qualcomm IPQ6018 (4x Cortex-A53, 800 MHz)
// RAM:   512 MiB
// Flash: 256 MiB NAND (QPIC)
// WiFi:  IPQ6018 integrated (2.4/5 GHz) + optional QCN9000 PCIe
// ETH:   5x SGMII via QCA ESS-SWITCH (dp1-dp5)
// USB:   1x USB3 + 1x USB2
// PCIe:  1x Gen3

/dts-v1/;

#include "ipq6018-512m.dtsi"
#include "ipq6018-ess.dtsi"
#include "ipq6018-nss.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "IPQ6018-SRS821";
	compatible = "smwave,srs821", "qcom,ipq6018";

	aliases {
		serial0   = &blsp1_uart3;   /* /soc/serial@78b1000 — console */
		serial2   = &blsp1_uart2;   /* /soc/serial@78b0000 */
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " root=/dev/ubiblock0_1 rootfstype=squashfs rootwait";
	};

	/*
	 * GPIO buttons
	 * WPS:   GPIO 19 (active-low)
	 * Reset: GPIO 9  (active-low)
	 */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&tlmm 19 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			debounce-interval = <60>;
		};

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 9 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_KEY>;
			debounce-interval = <60>;
		};
	};

	/*
	 * GPIO LEDs
	 * GPIO 35: RM500 modem power indicator (active-high, default on)
	 * GPIO 63: Wi-Fi LED        (active-high)
	 * GPIO 67: RSSI bar 1       (active-high)
	 * GPIO 68: RSSI bar 2       (active-high)
	 * GPIO 69: RSSI bar 3       (active-high)
	 * GPIO 70: Net LED 1        (active-high)
	 * GPIO 73: Net LED 2        (active-high)
	 * GPIO 74: Net LED 3        (active-high)
	 */
	gpio-leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		rm500_on {
			label = "rm500_on";
			gpios = <&tlmm 35 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "rm500_on";
			default-state = "on";
		};

		led_wifi_1 {
			label = "led_wifi_1";
			gpios = <&tlmm 63 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "led_wifi_1";
			default-state = "off";
		};

		led_rssi_1 {
			label = "led_rssi_1";
			gpios = <&tlmm 67 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "led_rssi_1";
			default-state = "off";
		};

		led_rssi_2 {
			label = "led_rssi_2";
			gpios = <&tlmm 68 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "led_rssi_2";
			default-state = "off";
		};

		led_rssi_3 {
			label = "led_rssi_3";
			gpios = <&tlmm 69 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "led_rssi_3";
			default-state = "off";
		};

		led_net_1 {
			label = "led_net_1";
			gpios = <&tlmm 70 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "led_net_1";
			default-state = "off";
		};

		led_net_2 {
			label = "led_net_2";
			gpios = <&tlmm 73 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "led_net_2";
			default-state = "off";
		};

		led_net_3 {
			label = "led_net_3";
			gpios = <&tlmm 74 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "led_net_3";
			default-state = "off";
		};
	};
};

/* =====================================================================
 * SoC node overrides
 * ===================================================================== */

&tlmm {
	/*
	 * Console UART: GPIO 44 (TX) / 45 (RX) — blsp2_uart / serial@78b1000
	 * Baud: 115200n8
	 */
	uart_pins: uart-pins {
		pins = "gpio44", "gpio45";
		function = "blsp2_uart";
		drive-strength = <8>;
		bias-pull-down;
	};

	/* BLSP1 UART (RS-232): GPIO 71 / 72 */
	hsuart_232_pins: hsuart-232-pins {
		pins = "gpio71", "gpio72";
		function = "blsp1_uart";
		drive-strength = <8>;
		bias-disable;
	};

	/* BLSP4 UART (RS-485): GPIO 57 / 58 */
	hsuart_485_pins: hsuart-485-pins {
		pins = "gpio57", "gpio58";
		function = "blsp4_uart";
		drive-strength = <8>;
		bias-disable;
	};

	/* SPI0: GPIO 38–41 (NOR flash, n25q128a11) */
	spi_0_pins: spi-0-pins {
		pins = "gpio38", "gpio39", "gpio40", "gpio41";
		function = "blsp0_spi";
		drive-strength = <8>;
		bias-pull-down;
	};

	/* USB ID sense: GPIO 26 */
	extcon_usb_pins: extcon-usb-pins {
		pins = "gpio26";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	/* MDIO: GPIO 64 (MDC) / 65 (MDIO) */
	/* PHY reset: GPIO 75, 77 */
	mdio_pins: mdio-pins {
		mdc  { pins = "gpio64"; function = "mdc";  drive-strength = <8>; bias-pull-up; };
		mdio { pins = "gpio65"; function = "mdio"; drive-strength = <8>; bias-pull-up; };
	};

	/* GPIO buttons */
	button_pins: button-pins {
		wps   { pins = "gpio19"; function = "gpio"; drive-strength = <8>; bias-pull-up; };
		reset { pins = "gpio9";  function = "gpio"; drive-strength = <8>; bias-pull-up; };
	};

	/* GPIO LEDs */
	leds_pins: leds-pins {
		rm500  { pins = "gpio35"; function = "gpio"; drive-strength = <8>; bias-pull-up; };
		wifi   { pins = "gpio63"; function = "gpio"; drive-strength = <8>; bias-pull-down; };
		rssi1  { pins = "gpio67"; function = "gpio"; drive-strength = <8>; bias-pull-down; };
		rssi2  { pins = "gpio68"; function = "gpio"; drive-strength = <8>; bias-pull-down; };
		rssi3  { pins = "gpio69"; function = "gpio"; drive-strength = <8>; bias-pull-down; };
		net1   { pins = "gpio70"; function = "gpio"; drive-strength = <8>; bias-pull-down; };
		net2   { pins = "gpio73"; function = "gpio"; drive-strength = <8>; bias-pull-down; };
		net3   { pins = "gpio74"; function = "gpio"; drive-strength = <8>; bias-pull-down; };
	};

	/* I2C1: GPIO 42 (SDA) / 43 (SCL) */
	i2c_1_pins: i2c-1-pins {
		pins = "gpio42", "gpio43";
		function = "blsp2_i2c";
		drive-strength = <8>;
		bias-pull-down;
	};
};

&blsp1_uart3 {
	pinctrl-0 = <&uart_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* RS-232: serial@78b0000 */
&blsp1_uart2 {
	pinctrl-0 = <&hsuart_232_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* =====================================================================
 * SPI / NOR (n25q128a11 on CS0)
 * ===================================================================== */
&blsp1_spi1 {
	pinctrl-0 = <&spi_0_pins>;
	pinctrl-names = "default";
	cs-select = <0>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
		#address-cells = <1>;
		#size-cells = <1>;
	};
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";

	nand@0 {
		reg = <0>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;
		
		partitions {
			compatible = "qcom,smem-part";
		};
	};	
};

&blsp1_i2c3 {
	pinctrl-0 = <&i2c_1_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&mdio {
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	status = "okay";
	reset-gpios = <&tlmm 75 GPIO_ACTIVE_LOW>, <&tlmm 77 GPIO_ACTIVE_HIGH>;

	ethernet-phy-package@0 {
		compatible = "qcom,qca8075-package";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;

		qca8075_0: ethernet-phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <0>;
		};
		qca8075_1: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <1>;
		};
		qca8075_2: ethernet-phy@2 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <2>;
		};
		qca8075_3: ethernet-phy@3 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <3>;
		};

		qca8075_4: ethernet-phy@4 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <4>;
		};
	};
};

&switch {
	status = "okay";
	switch_lan_bmp = <(ESS_PORT4)>;
	switch_wan_bmp = <ESS_PORT5>;
	switch_mac_mode = <MAC_MODE_PSGMII>;
	
	qcom,port_phyinfo {
		port@4 {
			port_id = <4>;
			phy_address = <3>;
		};
		port@5 {
			port_id = <5>;
			phy_address = <4>;
		};
	};
};

&edma {
	status = "okay";
};

&dp4 {
	status = "okay";
	phy-handle = <&qca8075_3>;
	label = "lan";
};

&dp5 {
	status = "okay";
	phy-handle = <&qca8075_4>;
	label = "wan";
};

&ssphy_0 {
	status = "okay";
};

&qusb_phy_0 {
	status = "okay";
};

&qusb_phy_1 {
	status = "okay";
};

&usb3 {
	status = "okay";
};

&usb2 {
	status = "okay";
};

&pcie_phy {
	status = "okay";
};

&wifi {
	status = "okay";
	qcom,ath11k-calibration-variant = "GL-iNet-GL-AX1800";
	qcom,ath11k-fw-memory-mode = <1>;
};